{
  "BpLogViewer": {
    "Database": {
      "ConnectionString": "REPLACE_WITH_YOUR_CONNECTION_STRING",
      "LocalDbInstance": "BluePrismLocalDB"
    },
    "Output": {
      "DefaultFormat": "jsonl",
      "MaxRowsBeforeFile": 1000,
      "MaxRowsAbsoluteCeiling": 100000
    },
    "Timezone": {
      "DisplayTimezone": "Europe/Berlin"
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.Data.SqlClient": "Warning"
      }
    }
  }
}
