<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!--
      Single-RID-Setup: Wir bauen ausschließlich win-x64 (Blue Prism läuft nur
      auf Windows). Dadurch erzeugt `dotnet restore` immer einen Asset-File
      für `net8.0/win-x64`, und `dotnet publish -r win-x64` läuft ohne
      NETSDK1047 ("Assets file doesn't have a target for 'net8.0/win-x64'").
      Wenn später linux-x64 / arm64 dazukommen sollen, stattdessen
      RuntimeIdentifiers (Plural) verwenden.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>BpLogViewer.Cli</RootNamespace>
    <AssemblyName>bp-log-viewer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      Release-Optimierungen für minimale Binary-Größe.
      - InvariantGlobalization=false: SqlClient benötigt benannte Kulturen (z. B. en-US).
      - PublishSingleFile + IncludeNativeLibrariesForSelfExtract:
        eine einzige .exe; benötigt die .NET-8-Runtime (x64) auf dem Zielsystem.
      - DebugType=None / DebugSymbols=false: keine PDBs, keine Source-Info.
      Diese Properties sind im .csproj zentral, damit `dotnet publish` ohne
      zusätzliche -p:-Flags die Release-Binary erzeugt.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- SqlClient 5.x verursacht im getrimmten Publish TypeLoadException beim TLS-Login. -->
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!--
      Trim-Warnings sind Library-internal (SqlClient SNI, Azure.Core,
      IdentityModel) und nicht durch unsere App-Code-Patterns verursacht.
      Wir nutzen JsonTypeInfo-Source-Generator und vermeiden Reflection,
      die wenigen Reflection-Stellen in System.Data.DataSet/DataTable
      (XmlSchema) werden nicht von uns aufgerufen.
    -->
    <NoWarn>$(NoWarn);IL2026;IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Bewusst schlank gehalten: nur die Pakete, die wir wirklich nutzen.
      Entfernt wurden (brachten ~1–2 MB ohne Verwendung):
      - Microsoft.Extensions.DependencyInjection (wir nutzen kein DI-Container)
      - Microsoft.Extensions.Hosting (kein Host-Setup)
      - Microsoft.Extensions.Logging / Logging.Console (kein ILogger)
      - System.CommandLine (manueller Dispatcher, Migration zurück ist
        später mit Add-Package möglich; siehe Notiz in Program.cs)
    -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
  </ItemGroup>

  <!--
    appsettings.json wird beim Build ins Output-Verzeichnis kopiert, damit
    ConfigurationLoader (Anchor = AppContext.BaseDirectory) sie im Dev-Build findet.
    In Production liegt appsettings.json neben der deployed Binary.
  -->
  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
