<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!--
      Single-RID-Setup: Wir bauen ausschließlich win-x64 (Blue Prism läuft nur
      auf Windows). Dadurch erzeugt `dotnet restore` immer einen Asset-File
      für `net8.0/win-x64`, und `dotnet publish -r win-x64` läuft ohne
      NETSDK1047 ("Assets file doesn't have a target for 'net8.0/win-x64'").
      Wenn später linux-x64 / arm64 dazukommen sollen, stattdessen
      RuntimeIdentifiers (Plural) verwenden.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>BpLogViewer.Cli</RootNamespace>
    <AssemblyName>bp-log-viewer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

  <!--
    appsettings.json wird beim Build ins Output-Verzeichnis kopiert, damit
    ConfigurationLoader (Anchor = AppContext.BaseDirectory) sie im Dev-Build findet.
    In Production liegt appsettings.json neben der deployed Binary.
  -->
  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
